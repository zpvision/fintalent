DATABASE_URL=postgres://USER:PASSWORD@CLOUD_HOST:5432/DATABASE?sslmode=require
APP_ENV=development
PORT=8080
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-me
COOKIE_SECURE=false
SEED_DEMO_DATA=false
SYNC_GEOGRAPHY=false
APP_BASE_URL=http://127.0.0.1:8080
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USERNAME=mailer@example.com
SMTP_PASSWORD=change-me
PASSWORD_RESET_SECRET=replace-with-at-least-32-random-characters
SMTP_FROM=mailer@example.com
SMTP_FROM_NAME=FinTalent

# Only actual reverse proxy networks; never use 0.0.0.0/0.
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
DB_MAX_OPEN_CONNS=16

# Chromium executable for server-side HTML to PDF (install on the application host).
PDF_CHROMIUM_PATH=/usr/bin/chromium

# Shared file storage: the existing driver name is retained for all modules.
# Production requires private S3; development may use driver=local.
ACADEMY_STORAGE_DRIVER=s3
ACADEMY_STORAGE_DIR=/var/lib/fintalent/academy
S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true
S3_PRESIGN_TTL_SECONDS=300
ACADEMY_VIDEO_MAX_MB=2048
